[init]
  defaultBranch = main
[pull]
  rebase = true
[push]
  default = current
  autoSetupRemote = true
[color]
  ui = auto
[alias]
  aa = add --all
  ap = add --patch
  branches = for-each-ref --sort=-committerdate --format=\"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/remotes
  ci = commit -v
  co = checkout
  pf = push --force-with-lease
  st = status
  unstage = reset HEAD --
	cleanup = !~/bin/git-cleanup
  wt = "!f(){ branch=\"$1\"; [ -n \"$branch\" ] || { echo 'usage: git wt <branch-name> [path] [base-ref]' >&2; exit 1; }; repo_root=\"$(git rev-parse --show-toplevel)\" || exit 1; repo_name=\"$(basename \"$repo_root\")\"; branch_suffix=\"$(printf '%s' \"$branch\" | tr '/:' '-')\"; worktree_path=\"${2:-$repo_root/../$repo_name-$branch_suffix}\"; base_ref=\"${3:-origin/main}\"; [ ! -e \"$worktree_path\" ] || { echo \"target path already exists: $worktree_path\" >&2; exit 1; }; git fetch origin && git worktree add -b \"$branch\" \"$worktree_path\" \"$base_ref\" && [ -f \"$worktree_path/package.json\" ] && pnpm install --dir \"$worktree_path\"; }; f"
[core]
  excludesfile = ~/.gitignore
  autocrlf = input
  editor = nvim
  pager = delta
  fsmonitor = true
  untrackedCache = true
[commit]
  template = ~/.gitmessage
[fetch]
  prune = true
[log]
  abbrevCommit = true
  follow = true
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[status]
  showUntrackedFiles = all
[stash]
  showPatch = true
[help]
  autocorrect = prompt
[rebase]
  autosquash = true
  updateRefs = true
  missingCommitsCheck = warn
[include]
  path = ~/.gitconfig.local
[diff]
  tool = vimdiff
  keepBackup = false
  algorithm = histogram
  colorMoved = default
  renames = copies
[mergetool "nvim"]
  cmd = nvim -f -c \"Gdiff\" \"$MERGED\"
[mergetool "vimdiff"]
  cmd = nvim -d $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
[rerere]
  enabled = 1
[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
[interactive]
  diffFilter = delta --color-only
[mergetool]
  keepBackup = false
[merge]
  tool = vimdiff
  conflictstyle = zdiff3
  log = true
[credential]
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://codeberg.org"]
	provider = generic
[user]
	email = RMParsley@gmail.com
	name = Ryan Parsley
