{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "share": "disabled",
  "plugin": [
    "~/.config/opencode/plugins/hook-guard.js",
    "~/.config/opencode/plugins/main-branch-guard.js",
    "~/.config/opencode/plugins/test-enforcement.js",
    "~/.config/opencode/plugins/lint-enforcement.js",
    "~/.config/opencode/plugins/build-enforcement.js",
    "~/.config/opencode/plugins/tdd-enforcement.ts"
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "chrome-devtools-mcp@latest"],
      "enabled": true,
      "timeout": 50000
    },
    "firefox-devtools": {
      "type": "local",
      "command": [
        "npx", "-y", "firefox-devtools-mcp@latest",
        "--headless", "--viewport", "1280x720"
      ],
      "enabled": true
    },
    "cerebro": {
      "type": "local",
      "command": ["cerebro", "mcp"],
      "enabled": true
    },
    "adrs": {
      "type": "local",
      "command": ["adrs", "mcp", "serve"],
      "enabled": true
    },
    "codeberg": {
      "type": "local",
      "command": [
        "forgejo-mcp", "--transport", "stdio", "--url", "https://codeberg.org"
      ],
      "environment": {
        "FORGEJO_ACCESS_TOKEN": "{env:CODEBERG_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "forgejo": {
      "type": "local",
      "command": [
        "forgejo-mcp", "--transport", "stdio",
        "--url", "https://forgejo.parsley.familyds.com/"
      ],
      "environment": {
        "FORGEJO_ACCESS_TOKEN": "{env:FORGEJO_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "dokploy-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@ahdev/dokploy-mcp"],
      "environment": {
        "DOKPLOY_URL": "https://dokploy.fretsome.com/api",
        "DOKPLOY_API_KEY": "{env:DOKPLOY_API_KEY}"
      },
      "enabled": true
    }
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "google/gemma-3n-e4b":                   { "name": "Gemma 3n-e4b (local)" },
        "ishumilin/deepseek-r1-coder-tools:8b":  { "name": "Deepseek Coder Tools (8b)" },
        "olmo2":                                  { "name": "OLMo 2" },
        "qwen3":                                  { "name": "Qwen 3" },
        "qwen3-coder":                            { "name": "Qwen 3 Coder" }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "gemma4:31b":              { "name": "Gemma 4 31b",         "tool_call": true },
        "gemma4:31b-128k":       { "name": "Gemma 4 31b (128k)",  "tool_call": true },
        "gemma4:31b-256k":       { "name": "Gemma 4 31b (256k)",  "tool_call": true },
        "gemma4:31b-mxfp8":      { "name": "Gemma 4 31b (MXFP8)", "tool_call": true },
        "gemma4:26b":              { "name": "Gemma 4 26b",         "tool_call": true },
        "gemma4:26b-64k":        { "name": "Gemma 4 26b (64k)",   "tool_call": true },
        "gemma4:26b-128k":       { "name": "Gemma 4 26b (128k)",  "tool_call": true },
        "gemma4:26b-256k":       { "name": "Gemma 4 26b (256k)",  "tool_call": true },
        "qwen3.6:27b":             { "name": "Qwen 3.6 27b",        "tool_call": true },
        "qwen3.6:latest":          { "name": "Qwen 3.6",            "tool_call": true },
        "ministral-3:8b":          { "name": "Ministral 3 8b",      "tool_call": true },
        "devstral:latest":         { "name": "Devstral",            "tool_call": true },
        "nemotron-3-nano:4b":      { "name": "Nemotron 3 Nano 4b",  "tool_call": true },
        "rnj-1:8b":                { "name": "RNJ-1 8b",            "tool_call": true },
        "functiongemma:270m":      { "name": "FunctionGemma 270M",   "tool_call": true },
        "kimi-k2.5:cloud":         { "name": "Kimi K2.5 (Cloud)",   "tool_call": true }
      }
    }
  },
  "permission": {
    "read": {
      "~/Projects/*": "allow"
    }
  }
}
